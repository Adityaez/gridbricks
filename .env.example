# WindSight Environment Configuration Example
# Copy this file to .env and adjust variables as needed.

# Elexon BMRS API Key (Optional depending on endpoint authentication)
ELEXON_API_KEY=

# Backend CORS Allowed Origins (JSON array format)
BACKEND_CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "https://*.vercel.app"]

# Default Decision Cutoff Strategy (e.g. day_ahead_1700, gate_closure, fixed_lead_hours)
DEFAULT_CUTOFF_RULE=day_ahead_1700

# Backend Port and Host
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Frontend Base API URL
VITE_API_BASE_URL=http://localhost:8000

